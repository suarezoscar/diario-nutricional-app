{
  "expo": {
    "name": "Diario Nutricional",
    "slug": "diario-nutricional-app",
    "version": "1.0.28",
    "scheme": "diarionutricional",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.oscar.diarionutricional",
      "versionCode": 29,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1b5e20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1b5e20"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ComidaWidget",
              "label": "Comida en curso",
              "description": "Comida actual, accesos rápidos de foto/texto y lista de comidas pendientes de hoy",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sqlite"
    ]
  }
}
